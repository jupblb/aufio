{
  "name": "aufio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local FiiO KA17 EQ control with durable presets and verified readback",
  "bin": {
    "aufio": "bin/aufio.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "aufio": "node bin/aufio.mjs",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "format": "prettier --write --single-quote --print-width 100 src test bin",
    "format:check": "prettier --check --single-quote --print-width 100 src test bin"
  },
  "dependencies": {
    "commander": "15.0.0",
    "node-hid": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "typescript": "7.0.2"
  }
}
